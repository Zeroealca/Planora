# Supabase (públicas — solo anon key en el cliente)
# Project URL de Settings → API, p. ej. https://xxxx.supabase.co
# NO uses la URL del dashboard (supabase.com/dashboard/...)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Solo pruebas E2E remotas (opcionales; NUNCA producción; no commitear valores) ---
# Requieren un proyecto Supabase aislado con migraciones aplicadas y un usuario sintético.
# La suite segura (npm run test:e2e sin estas vars) usa https://e2e.invalid y no las necesita.
# E2E_SUPABASE_URL=
# E2E_SUPABASE_ANON_KEY=
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
# E2E_ALLOWED_SUPABASE_REF=          # ref del proyecto aislado (subdominio de *.supabase.co)
# E2E_BLOCKED_SUPABASE_REFS=         # opcional, refs de producción separados por coma

# --- Solo pruebas E2E locales (Docker; archivo .env.e2e.local ignorado) ---
# Generar con: npm run e2e:local:prepare
# La protección exige E2E_LOCAL_SUPABASE=true y una URL localhost/127.0.0.1.
# E2E_LOCAL_SUPABASE=true
# E2E_SUPABASE_URL=http://127.0.0.1:54321
# E2E_SUPABASE_ANON_KEY=
# E2E_SERVICE_ROLE_KEY=               # solo script local; nunca VITE_*
# E2E_USER_EMAIL=planora-e2e-a@example.com
# E2E_USER_PASSWORD=
# E2E_USER_B_EMAIL=planora-e2e-b@example.com
# E2E_USER_B_PASSWORD=

# Opcional: URL pública del sitio (p. ej. https://tu-app.vercel.app)
# Útil si el build no corre en el navegador al registrar usuarios.
# También se usa como enlace en correos de recordatorio si PLANORA_SITE_URL no está en el job.
VITE_SITE_URL=

# --- Solo server-side (NO VITE_* para secretos; no commitear valores reales) ---
#
# Vercel (cron proxy /api/cron/scheduled-payment-reminders):
# CRON_SECRET=                 # Bearer de Vercel Cron; solo en Vercel
# REMINDER_JOB_SECRET=         # Mismo valor que en Supabase Edge Function secrets
# VITE_SUPABASE_URL=           # Ya suele existir en Vercel (URL pública, no secreta)
#
# Supabase Edge Function secrets (processor + Resend):
# REMINDER_JOB_SECRET=         # Autentica process-scheduled-payment-reminders
# RESEND_API_KEY=              # Solo en Supabase
# REMINDER_FROM_EMAIL=         # Remitente verificado, p. ej. Planora <noreply@tudominio.com>
# PLANORA_SITE_URL=            # URL pública para el enlace del correo
